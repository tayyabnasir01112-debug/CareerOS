CAREEROS_ENVIRONMENT=development
CAREEROS_LOG_LEVEL=INFO
CAREEROS_DATABASE_URL=sqlite+aiosqlite:///./data/careeros.db
CAREEROS_CANDIDATE_PROFILE_PATH=config/candidate_profile.yaml
CAREEROS_JOB_PREFERENCES_PATH=config/job_preferences.yaml
CAREEROS_SOURCE_CONFIG_PATH=config/source_config.yaml
CAREEROS_SOURCE_REGISTRY_PATH=config/source_registry.yaml
# Recruiter evaluation. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_RECRUITER_MODEL=gpt-5.4-mini
OPENAI_MAX_EVALUATIONS_PER_RUN=5
OPENAI_MAX_EVALUATIONS_PER_DAY=20
OPENAI_MAX_INPUT_CHARACTERS=18000
OPENAI_REQUEST_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BASE_SECONDS=0.5
# Discord job notifications. Keep the real webhook only in the ignored local .env file.
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFICATIONS_ENABLED=true
DISCORD_MINIMUM_MATCH_SCORE=75
DISCORD_NOTIFY_CONSIDER=true
DISCORD_REQUIRE_CONFIRMED_LOCATION=true
DISCORD_MAX_NOTIFICATIONS_PER_RUN=5
DISCORD_REQUEST_TIMEOUT_SECONDS=20
DISCORD_MAX_RETRIES=2
DISCORD_RETRY_BASE_SECONDS=0.5
